# TransLink API
TRANSLINK_API_KEY=your_api_key_here

# GCP Project
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1

# BigQuery
BQ_DATASET=staging
BQ_FEATURE_DATASET=ml_features

# GCS Buckets
GCS_RAW_BUCKET=translink-raw-data
GCS_MODELS_BUCKET=translink-models

# Local Paths (adjust for your system)
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model Settings
MODEL_NAME=logistic_regression
PREDICTION_THRESHOLD=0.5

# Feature Engineering
RETENTION_DAYS=28
ROLLING_WINDOW_DAYS=28
